{
  "name": "quota-mcp-server",
  "version": "0.1.0",
  "description": "A shared API-quota broker for fleets of AI agents: one ledger per service and account, owner-set rate and concurrency limits, on Cloudflare Workers.",
  "mcpName": "io.github.sapientsai/quota-mcp-server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rate-limit",
    "quota",
    "github",
    "agents",
    "cloudflare-workers",
    "durable-objects",
    "somamcp",
    "typescript"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/quota#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/quota"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "bin": {
    "quota-hook": "./dist/hook.js"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "build": "pnpm check:version && ts-builds build && pnpm check:worker",
    "check:worker": "node scripts/check-worker-bundle.mjs",
    "dev": "ts-builds dev",
    "cf:dev": "wrangler dev",
    "prepublishOnly": "pnpm run ci && pnpm check:version && pnpm check:worker",
    "sync:version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add src/version.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7",
    "wrangler": "^4.166.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "dependencies": {
    "functype": "^2.0.0",
    "somamcp": "^2.11.1",
    "zod": "^4.6.7"
  }
}
