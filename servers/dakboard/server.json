{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sapientsai/dakboard-mcp-server",
  "description": "Manage DAKboard digital dashboards: screens, blocks, devices, loops and metrics.",
  "repository": {
    "url": "https://github.com/sapientsai/mcp-servers",
    "source": "github",
    "subfolder": "servers/dakboard"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dakboard-mcp-server",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DAKBOARD_API_KEY",
          "description": "DAKboard API key for authentication",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
