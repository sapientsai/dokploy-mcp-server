{
  "name": "dakboard-mcp-server",
  "version": "1.0.1",
  "description": "A Model Context Protocol (MCP) server for DAKboard - manage screens, blocks, devices, loops, and metrics.",
  "type": "module",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dakboard-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "NODE_ENV=production ts-builds build",
    "dev": "ts-builds dev",
    "prepublishOnly": "pnpm run ci",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector dist/index.js",
    "start": "pnpm build && npx dakboard-mcp-server",
    "serve": "pnpm build && node dist/index.js",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "check:server-json": "node scripts/sync-server-json.mjs --check",
    "version": "node scripts/sync-server-json.mjs && git add server.json"
  },
  "prettier": "ts-builds/prettier",
  "keywords": [
    "mcp",
    "dakboard",
    "api",
    "model-context-protocol",
    "claude",
    "ai-assistant",
    "digital-signage",
    "dashboard",
    "fastmcp"
  ],
  "mcpName": "io.github.sapientsai/dakboard-mcp-server",
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/dakboard"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/dakboard#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^4.0.1",
    "functype": "^0.60.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "ts-builds": "^4.7.0",
    "tsdown": "^0.22.0"
  }
}
