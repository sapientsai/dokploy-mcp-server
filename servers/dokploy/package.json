{
  "name": "dokploy-mcp-server",
  "version": "1.11.2",
  "mcpName": "io.github.sapientsai/dokploy-mcp-server",
  "description": "A comprehensive Model Context Protocol (MCP) server for Dokploy - deploy apps, manage containers, databases, domains, and servers.",
  "keywords": [
    "mcp",
    "dokploy",
    "devops",
    "deployment",
    "docker",
    "model-context-protocol",
    "claude",
    "ai-assistant",
    "fastmcp",
    "self-hosted",
    "paas"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/dokploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/dokploy"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dokploy-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "pnpm check:versions && pnpm check:readme && ts-builds validate && pnpm smoke",
    "ci": "pnpm check:versions && pnpm check:readme && ts-builds ci && pnpm smoke",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "NODE_ENV=production ts-builds build",
    "dev": "ts-builds dev",
    "check:versions": "tsx scripts/check-versions.ts",
    "check:readme": "tsx scripts/check-readme.ts",
    "smoke": "tsx scripts/smoke-stdio.ts",
    "sync:versions": "tsx scripts/sync-versions.ts",
    "version": "pnpm sync:versions",
    "prepublishOnly": "pnpm check:versions && pnpm run ci",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector dist/index.js",
    "start": "pnpm build && node dist/bin.js",
    "serve": "pnpm build && node dist/index.js",
    "openapi:fetch": "tsx scripts/fetch-openapi.ts",
    "openapi:generate": "openapi-typescript openapi.json -o src/generated/dokploy-api.ts --export-type -t",
    "openapi:update": "pnpm openapi:fetch && pnpm openapi:generate && pnpm format"
  },
  "prettier": "ts-builds/prettier",
  "dependencies": {
    "dotenv": "^18.0.10",
    "functype": "^2.0.0",
    "functype-log": "^2.0.0",
    "pino": "^10.4.0",
    "somamcp": "^2.11.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
