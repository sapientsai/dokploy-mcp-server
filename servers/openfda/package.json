{
  "name": "openfda-mcp-server",
  "version": "3.0.0",
  "description": "MCP server for querying U.S. FDA public datasets - drugs, devices, adverse events, recalls, and more",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fda",
    "openfda",
    "drugs",
    "medical-devices",
    "somamcp",
    "typescript"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/openfda#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/openfda"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "serve:test": "tsx src/index.ts",
    "serve:test:http": "tsx src/index.ts --transport http",
    "prepublishOnly": "pnpm run ci"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "fflate": "^0.8.3",
    "functype": "^2.0.0",
    "functype-log": "^2.0.0",
    "somamcp": "^2.11.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "bin": {
    "openfda-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./tools": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "engines": {
    "node": ">=22.12"
  }
}
