{
  "name": "rescuetime-mcp-server",
  "version": "1.3.0",
  "description": "A Model Context Protocol (MCP) server for RescueTime - access productivity data, focus sessions, Timesheets timers and project time, highlights, and activity tracking.",
  "keywords": [
    "mcp",
    "rescuetime",
    "productivity",
    "api",
    "model-context-protocol",
    "claude",
    "ai-assistant",
    "somamcp",
    "focus",
    "timesheets",
    "time-tracking"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/rescuetime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/rescuetime"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "NODE_ENV=production ts-builds build",
    "dev": "ts-builds dev",
    "prepublishOnly": "pnpm run ci",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector dist/index.js",
    "start": "pnpm build && npx rescuetime-mcp-server",
    "serve": "pnpm build && node dist/index.js"
  },
  "bin": {
    "rescuetime-mcp-server": "dist/bin.js"
  },
  "mcpName": "io.github.sapientsai/rescuetime-mcp-server",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "prettier": "ts-builds/prettier",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "functype": "^2.0.0",
    "somamcp": "^2.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7"
  }
}
