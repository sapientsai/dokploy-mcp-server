{
  "name": "beszel-mcp-server",
  "version": "0.2.0",
  "description": "A Model Context Protocol (MCP) server for Beszel - read your monitored systems, their metrics over time, containers, systemd services, disk health and alerts.",
  "keywords": [
    "mcp",
    "beszel",
    "monitoring",
    "server-monitoring",
    "docker",
    "pocketbase",
    "model-context-protocol",
    "claude",
    "ai-assistant",
    "somamcp",
    "self-hosted"
  ],
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/mcp-servers/tree/main/servers/beszel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapientsai/mcp-servers.git",
    "directory": "servers/beszel"
  },
  "bugs": {
    "url": "https://github.com/sapientsai/mcp-servers/issues"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "NODE_ENV=production ts-builds build",
    "dev": "ts-builds dev",
    "prepublishOnly": "pnpm run ci && pnpm check:server-json",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector dist/index.js",
    "start": "pnpm build && npx beszel-mcp-server",
    "serve": "pnpm build && node dist/index.js",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "check:server-json": "node scripts/sync-server-json.mjs --check",
    "version": "node scripts/sync-server-json.mjs && git add server.json"
  },
  "bin": {
    "beszel-mcp-server": "dist/bin.js"
  },
  "mcpName": "io.github.sapientsai/beszel-mcp-server",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "prettier": "ts-builds/prettier",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "functype": "^2.0.0",
    "somamcp": "^2.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  }
}
