# Required: your Beszel hub's base URL
BESZEL_URL=https://beszel.example.com

# Sign in with a Beszel user (ideally one with the readonly role)...
BESZEL_EMAIL=readonly@example.com
BESZEL_PASSWORD=your_password_here

# ...or with a PocketBase auth token, for hubs that allow OAuth sign-in only
# BESZEL_TOKEN=

# Optional: Transport mode (stdio or httpStream)
# TRANSPORT_TYPE=stdio

# Optional: HTTP port when using httpStream transport
# PORT=3000
